# ============================================================
# AWS WAFv2 - Public ALB Protection
# ============================================================

resource "aws_wafv2_web_acl" "main" {
  name        = "msa-platform-waf"
  description = "WAF for MSA Platform Public ALB"
  scope       = "REGIONAL"

  default_action {
    allow {}
  }

  # ----------------------------------------------------------
  # Rule 1 - AWS Common Rule Set
  # SQL Injection, XSS 등 일반적인 웹 공격 방어
  # ----------------------------------------------------------
  rule {
    name     = "AWSManagedRulesCommonRuleSet"
    priority = 10

    override_action {
      none {}
    }

    statement {
      managed_rule_group_statement {
        name        = "AWSManagedRulesCommonRuleSet"
        vendor_name = "AWS"
      }
    }

    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "AWSManagedRulesCommonRuleSet"
      sampled_requests_enabled   = true
    }
  }

  # ----------------------------------------------------------
  # Rule 2 - Known Bad Inputs
  # Log4Shell 등 알려진 취약 요청 패턴 방어
  # ----------------------------------------------------------
  rule {
    name     = "AWSManagedRulesKnownBadInputsRuleSet"
    priority = 20

    override_action {
      none {}
    }

    statement {
      managed_rule_group_statement {
        name        = "AWSManagedRulesKnownBadInputsRuleSet"
        vendor_name = "AWS"
      }
    }

    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "AWSManagedRulesKnownBadInputsRuleSet"
      sampled_requests_enabled   = true
    }
  }

  # ----------------------------------------------------------
  # Rule 3 - SQL Injection
  # ----------------------------------------------------------
  rule {
    name     = "AWSManagedRulesSQLiRuleSet"
    priority = 30

    override_action {
      none {}
    }

    statement {
      managed_rule_group_statement {
        name        = "AWSManagedRulesSQLiRuleSet"
        vendor_name = "AWS"
      }
    }

    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "AWSManagedRulesSQLiRuleSet"
      sampled_requests_enabled   = true
    }
  }

  # ----------------------------------------------------------
  # Rule 4 - Amazon IP Reputation
  # 악성 IP / Bot 등 평판 기반 차단
  # ----------------------------------------------------------
  rule {
    name     = "AWSManagedRulesAmazonIpReputationList"
    priority = 40

    override_action {
      none {}
    }

    statement {
      managed_rule_group_statement {
        name        = "AWSManagedRulesAmazonIpReputationList"
        vendor_name = "AWS"
      }
    }

    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "AWSManagedRulesAmazonIpReputationList"
      sampled_requests_enabled   = true
    }
  }

  # ----------------------------------------------------------
  # Rule 5 - Rate Limit
  # 동일 IP에서 과도한 요청 차단
  # ----------------------------------------------------------
  rule {
    name     = "RateLimit"
    priority = 50

    action {
      block {}
    }

    statement {
      rate_based_statement {
        limit              = 2000
        aggregate_key_type = "IP"
      }
    }

    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "RateLimit"
      sampled_requests_enabled   = true
    }
  }

  visibility_config {
    cloudwatch_metrics_enabled = true
    metric_name                = "msa-platform-waf"
    sampled_requests_enabled   = true
  }

  tags = {
    Name    = "msa-platform-waf"
    Project = "msa-platform"
  }
}

# ============================================================
# Find existing ALB created by AWS Load Balancer Controller
# ============================================================

data "aws_lb" "msa_public" {
  name = "k8s-msaplatformpublic-5d442f2ac3"
}


# ============================================================
# Associate WAF with ALB
# ============================================================

resource "aws_wafv2_web_acl_association" "main" {
  resource_arn = data.aws_lb.msa_public.arn
  web_acl_arn  = aws_wafv2_web_acl.main.arn
}
# ============================================================
# WAF CloudWatch Logs
# ============================================================

resource "aws_cloudwatch_log_group" "waf" {
  name              = "aws-waf-logs-msa-platform"
  retention_in_days = 7

  tags = {
    Name    = "aws-waf-logs-msa-platform"
    Project = "msa-platform"
  }
}

resource "aws_wafv2_web_acl_logging_configuration" "main" {
  resource_arn = aws_wafv2_web_acl.main.arn

  log_destination_configs = [
    aws_cloudwatch_log_group.waf.arn
  ]
}
